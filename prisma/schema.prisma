// Schema do banco. Depois de alterar, rode: npm run db:migrate
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Sessões do painel administrativo (usada pelo connect-pg-simple).
// Colunas e índice seguem o formato esperado pela biblioteca.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
