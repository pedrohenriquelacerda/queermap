# Copie para .env e ajuste. O .env nunca vai para o git.
NODE_ENV=development
PORT=3000
# Endereço público do site (links de compartilhamento e e-mails)
SITE_URL=http://localhost:3000

# Opção A (padrão): Postgres via Docker, bate com o compose.yaml
DATABASE_URL=postgresql://queermap:queermap@localhost:5432/queermap
# Opção B: sem Docker, com `npm run db:local` (Postgres embutido do Prisma)
# DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:51215/template1?sslmode=disable

# Em produção, gere um valor aleatório longo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio
# Segredo do hash dos e-mails (gere do mesmo jeito; diferente do SESSION_SECRET)
HASH_SECRET=troque-por-outro-valor-aleatorio

# true quando rodar atrás de proxy (Cloudflare Tunnel, Render etc.)
TRUST_PROXY=false

# Cloudflare Turnstile (anti-robô). Em branco no desenvolvimento = chaves de teste,
# que sempre aprovam. Em produção, crie as chaves no painel da Cloudflare.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# E-mail (código de confirmação e resumo diário).
# Sem SMTP_HOST no desenvolvimento, os e-mails são mostrados no terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE="Mapa SerQueer <nao-responda@exemplo.org>"
