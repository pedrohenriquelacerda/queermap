<%- include('../partials/head') %>
<main id="conteudo" class="painel-conteudo">
  <div class="cabecalho-pagina">
    <h1>Olá, <%= admin.nome.split(' ')[0] %></h1>
    <a class="botao" href="/painel/locais/novo">Novo local</a>
  </div>

  <ul class="indicadores">
    <li>
      <span class="cartao indicador">
        <span class="indicador__numero"><%= enviosNovos %></span>
        <span class="indicador__rotulo"><%= enviosNovos === 1 ? 'envio novo' : 'envios novos' %></span>
      </span>
    </li>
    <li>
      <a class="cartao indicador" href="/painel/locais?situacao=publicado">
        <span class="indicador__numero"><%= publicados %></span>
        <span class="indicador__rotulo"><%= publicados === 1 ? 'local publicado' : 'locais publicados' %></span>
      </a>
    </li>
    <li>
      <a class="cartao indicador" href="/painel/locais?situacao=rascunho">
        <span class="indicador__numero"><%= rascunhos %></span>
        <span class="indicador__rotulo"><%= rascunhos === 1 ? 'rascunho para revisar' : 'rascunhos para revisar' %></span>
      </a>
    </li>
  </ul>
</main>
<%- include('../partials/foot') %>
