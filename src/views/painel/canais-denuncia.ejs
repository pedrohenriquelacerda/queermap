<%- include('../partials/head') %>
<main id="conteudo" class="painel-conteudo">
  <div class="cabecalho-pagina">
    <h1>Canais de denúncia</h1>
  </div>
  <p class="campo__ajuda">
    Atualize os contatos oficiais exibidos no formulário de denúncia de discriminação e na página
    pública, ou adicione canais novos (por exemplo, o atendimento da prefeitura de outra cidade).
    Canais inativos deixam de aparecer para o público, mas podem ser reativados depois.
  </p>

  <% if (emEdicao || novoComErro) { %>
  <div class="alerta alerta--erro" role="alert"><p><strong>Revise os campos marcados.</strong></p></div>
  <% } %>

  <% if (canais.length === 0) { %>
  <div class="cartao estado-vazio"><p>Nenhum canal de denúncia cadastrado.</p></div>
  <% } %>

  <div class="canais-painel">
    <% for (const canal of canais) {
      // O canal que voltou com erro mostra o que foi digitado; os outros, o que está salvo.
      const comErro = emEdicao?.id === canal.id;
      const v = comErro ? emEdicao.valores : canal;
      const campoCanal = (dados) =>
        include('../partials/campo', { id: `canal-${canal.id}-${dados.nome}`, erros: comErro ? emEdicao.erros : {}, ...dados });
    %>
    <form class="cartao canais-painel__item" method="post" action="/painel/canais-denuncia/<%= canal.id %>" novalidate>
      <h2><%= canal.nome %></h2>
      <div class="canais-painel__campos">
        <%- campoCanal({ nome: 'nome', rotulo: 'Nome', valor: v.nome, attrs: { required: true, maxlength: 120 } }) %>
        <%- campoCanal({ nome: 'descricao', rotulo: 'Descrição', tipo: 'textarea', valor: v.descricao, attrs: { required: true, maxlength: 500, rows: 3 } }) %>
        <div class="form-inline__campos">
          <%- campoCanal({ nome: 'telefone', rotulo: 'Telefone', valor: v.telefone, attrs: { required: true, maxlength: 40 } }) %>
          <%- campoCanal({ nome: 'link', rotulo: 'Link oficial', tipo: 'url', valor: v.link, ajuda: 'Começa com http:// ou https://', attrs: { required: true, maxlength: 500 } }) %>
          <%- campoCanal({ nome: 'ordem', rotulo: 'Ordem', tipo: 'number', valor: v.ordem, attrs: { min: 0, max: 99 } }) %>
        </div>
        <%- campoCanal({ nome: 'abrangencia', rotulo: 'Abrangência', opcional: true, valor: v.abrangencia, ajuda: 'Onde o canal atende. Ex.: Porto Alegre, Rio Grande do Sul, Todo o Brasil.', attrs: { maxlength: 80 } }) %>
        <label class="opcao">
          <input type="checkbox" name="ativo" <%= v.ativo ? 'checked' : '' %> />
          <span>Exibir para o público</span>
        </label>
      </div>
      <button class="botao">Salvar canal</button>
    </form>
    <% } %>
  </div>

  <%
    const campoNovo = (dados) =>
      include('../partials/campo', { id: `canal-novo-${dados.nome}`, erros: novo.erros, ...dados });
    const n = novo.valores;
  %>
  <details class="cartao canais-painel__novo" <%= novoComErro ? 'open' : '' %>>
    <summary><h2>Adicionar canal</h2></summary>
    <form method="post" action="/painel/canais-denuncia" novalidate>
      <div class="canais-painel__campos">
        <%- campoNovo({ nome: 'nome', rotulo: 'Nome', valor: n.nome, ajuda: 'Ex.: 156 · Prefeitura de Canoas', attrs: { required: true, maxlength: 120 } }) %>
        <%- campoNovo({ nome: 'descricao', rotulo: 'Descrição', tipo: 'textarea', valor: n.descricao, attrs: { required: true, maxlength: 500, rows: 3 } }) %>
        <div class="form-inline__campos">
          <%- campoNovo({ nome: 'telefone', rotulo: 'Telefone', valor: n.telefone, attrs: { required: true, maxlength: 40 } }) %>
          <%- campoNovo({ nome: 'link', rotulo: 'Link oficial', tipo: 'url', valor: n.link, ajuda: 'Começa com http:// ou https://', attrs: { required: true, maxlength: 500 } }) %>
          <%- campoNovo({ nome: 'ordem', rotulo: 'Ordem', tipo: 'number', valor: n.ordem, attrs: { min: 0, max: 99 } }) %>
        </div>
        <%- campoNovo({ nome: 'abrangencia', rotulo: 'Abrangência', opcional: true, valor: n.abrangencia, ajuda: 'Onde o canal atende. Ex.: Porto Alegre, Rio Grande do Sul, Todo o Brasil.', attrs: { maxlength: 80 } }) %>
        <label class="opcao">
          <input type="checkbox" name="ativo" <%= n.ativo ? 'checked' : '' %> />
          <span>Exibir para o público</span>
        </label>
      </div>
      <button class="botao">Adicionar canal</button>
    </form>
  </details>
</main>
<%- include('../partials/foot') %>
