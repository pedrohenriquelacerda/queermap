<%- include('partials/head') %>
<main id="conteudo" class="explorar" data-modo="mapa">
  <%# Celular: botão flutuante que alterna entre o mapa e a lista (no computador fica escondido). %>
  <div class="explorar__alternar" role="group" aria-label="Modo de visualização">
    <button type="button" class="explorar__botao" data-ir-para="mapa" aria-pressed="true">Mapa</button>
    <button type="button" class="explorar__botao" data-ir-para="lista" aria-pressed="false">
      Lista <span class="explorar__total">(<span data-contagem-numero><%= locais.length %></span>)</span>
    </button>
  </div>

  <aside class="lateral" aria-labelledby="titulo-lista">
    <div class="lateral__topo">
      <h1 id="titulo-lista" class="lateral__titulo">Espaços de cuidado em Porto Alegre</h1>

      <% if (locais.length > 0) { %>
      <form class="filtros" action="/" id="filtros" aria-label="Filtros">
        <%# Busca na lista (nome, bairro, tipo ou característica). No celular fica sempre à vista, ao lado do botão Filtros. %>
        <div class="filtros__busca" role="search">
          <div class="campo campo--busca">
            <label class="visualmente-oculto" for="busca">Buscar local ou serviço</label>
            <input
              type="search"
              id="busca"
              name="q"
              placeholder="Buscar local ou serviço"
              autocomplete="off"
            />
          </div>
          <button
            type="button"
            class="botao botao--secundario filtros__abrir"
            id="abrir-filtros"
            aria-expanded="false"
            aria-controls="filtros-corpo"
          >
            Filtros <span class="filtros__contador" data-contador="total"></span>
          </button>
        </div>

        <%# Ordena a lista pelo mais perto (o mapa.js mostra o botão e usa a posição só no navegador). %>
        <div class="perto">
          <button type="button" class="botao botao--fantasma botao--pequeno" id="perto-de-mim" hidden>
            Perto de mim
          </button>
          <p class="perto__status" id="perto-status" role="status" aria-live="polite" hidden>
            <span id="perto-texto"></span>
            <button type="button" class="botao botao--fantasma botao--pequeno" id="perto-limpar">
              Ordem padrão
            </button>
          </p>
        </div>

        <div class="filtros__fundo" data-fechar-folha></div>
        <div class="filtros__corpo" id="filtros-corpo">
          <div class="filtros__cabecalho">
            <h2 class="filtros__titulo" id="filtros-titulo">Filtros</h2>
            <button type="button" class="filtros__fechar" data-fechar-folha aria-label="Fechar filtros">
              &times;
            </button>
          </div>

          <% if (destaque.length > 0) { %>
          <fieldset class="filtros__destaque">
            <legend>Mais procuradas</legend>
            <div class="chips">
              <% for (const c of destaque) { %>
              <label class="chip">
                <input type="checkbox" name="car" value="<%= c.slug %>" />
                <span><%= c.nome %></span>
              </label>
              <% } %>
            </div>
            <p class="filtros__dica">Mostra só os locais que têm todas as marcadas.</p>
          </fieldset>
          <% } %>

          <%# Aberto por padrão: o tipo de serviço é o filtro principal. %>
          <details class="filtros__grupo" open>
            <summary>Tipo de serviço <span class="filtros__contador" data-contador="tipo"></span></summary>
            <p class="filtros__dica">Marque mais de um para ver todos eles.</p>
            <% for (const c of categorias) { %>
            <label class="opcao<%= c.total === 0 ? ' opcao--zerada' : '' %>"<%- c.total === 0 ? ' title="Ainda não há locais deste tipo"' : '' %>>
              <input type="checkbox" <%- c.total === 0 ? 'disabled ' : '' %>name="tipo" value="<%= c.slug %>" />
              <span class="bolinha <%= fmt.classeCategoria(c) %>" aria-hidden="true"></span>
              <%= c.nome %>
              <span class="opcao__total">(<%= c.total %>)</span>
            </label>
            <% } %>
          </details>

          <% if (outras.length > 0) { %>
          <details class="filtros__grupo filtros__mais">
            <summary>
              <%= destaque.length > 0 ? 'Mais características' : 'Características' %>
              <span class="filtros__contador" data-contador="car-mais"></span>
            </summary>
            <p class="filtros__dica">Mostra só os locais que têm todas as marcadas.</p>
            <% for (const c of outras) { %>
            <label class="opcao">
              <input type="checkbox" name="car" value="<%= c.slug %>" />
              <%= c.nome %>
            </label>
            <% } %>
          </details>
          <% } %>

          <div class="filtros__rodape">
            <button type="button" class="botao botao--fantasma" data-limpar hidden>Limpar filtros</button>
            <button type="button" class="botao" data-fechar-folha>
              Ver <span data-contagem-numero><%= locais.length %></span>
              <span data-contagem-rotulo><%= locais.length === 1 ? 'local' : 'locais' %></span>
            </button>
          </div>
        </div>
      </form>

      <div class="resultado">
        <p id="contagem" role="status" aria-live="polite">
          <%= locais.length %> <%= locais.length === 1 ? 'local' : 'locais' %>
        </p>
        <button type="button" class="botao botao--fantasma botao--pequeno" id="limpar" data-limpar hidden>
          Limpar filtros
        </button>
      </div>
      <% } %>
    </div>

    <% if (locais.length === 0) { %>
    <p class="lateral__vazio">
      Nenhum local cadastrado ainda. Conhece um serviço que deveria estar aqui?
      <a href="/enviar">Envie uma sugestão de local</a>.
    </p>
    <% } else { %>
    <ul class="lista-locais" id="lista-locais">
      <% for (const l of locais) { %>
      <li
        class="cartao-local"
        data-id="<%= l.id %>"
        data-tipo="<%= l.categoria.slug %>"
        data-car="<%= l.caracteristicas.map((c) => c.slug).join(' ') %>"
        data-busca="<%= fmt.normalizar([l.nome, l.bairro, l.categoria.nome, ...l.caracteristicas.map((c) => c.nome)].join(' ')) %>"
      >
        <p class="rotulo-categoria <%= fmt.classeCategoria(l.categoria) %>"><%= l.categoria.nome %></p>
        <h2 class="cartao-local__nome"><a href="/locais/<%= l.slug %>"><%= l.nome %></a></h2>
        <p class="cartao-local__endereco"><%= fmt.endereco(l) %></p>
        <% if (l.caracteristicas.length > 0) { %>
        <ul class="etiquetas">
          <% for (const c of l.caracteristicas.slice(0, 3)) { %>
          <li class="etiqueta"><%= c.nome %></li>
          <% } %> <% if (l.caracteristicas.length > 3) { %>
          <li class="etiqueta etiqueta--neutra">+<%= l.caracteristicas.length - 3 %></li>
          <% } %>
        </ul>
        <% } %>
        <button type="button" class="botao botao--secundario botao--pequeno" data-mostrar="<%= l.id %>" aria-label="Ver no mapa: <%= l.nome %>">
          Ver no mapa
        </button>
      </li>
      <% } %>
    </ul>
    <p class="lateral__vazio" id="lista-vazia" data-aviso-vazio role="status" hidden>
      Nenhum local encontrado com esses filtros.
    </p>
    <% } %>
  </aside>

  <% if (locais.length > 0) { %>
  <%# Atalhos do filtro de tipo sobre o mapa, no celular (o mapa.js mostra e liga às caixas). Tipos sem locais ficam escondidos. %>
  <div class="atalhos-tipo" id="atalhos-tipo" hidden>
    <div class="atalhos-tipo__botoes" role="group" aria-label="Filtrar por tipo de serviço">
      <% for (const c of categorias) { %>
      <button type="button" class="atalho-tipo" data-atalho-tipo="<%= c.slug %>" aria-pressed="false"<%- c.total === 0 ? ' hidden' : '' %>>
        <span class="bolinha <%= fmt.classeCategoria(c) %>" aria-hidden="true"></span>
        <%= c.nome %>
      </button>
      <% } %>
    </div>
    <%# A lista fica escondida no modo mapa: o aviso de "nenhum local" aparece aqui também. %>
    <p class="atalhos-tipo__vazio" data-aviso-vazio role="status" hidden></p>
  </div>
  <% } %>

  <div id="mapa" class="mapa" role="region" aria-label="Mapa de Porto Alegre"></div>

  <%# Aparece sobre o mapa quando a localização não está disponível (o mapa.js o posiciona). %>
  <section class="painel-localizacao" id="painel-localizacao" aria-label="Sua localização" hidden>
    <button type="button" class="painel-localizacao__fechar" aria-label="Fechar">&times;</button>
    <p class="painel-localizacao__aviso" role="status" aria-live="polite"></p>
    <form class="painel-localizacao__form" action="/buscar-endereco">
      <label class="visualmente-oculto" for="endereco-pessoa">Endereço, bairro ou cidade</label>
      <div class="campo painel-localizacao__linha">
        <input
          type="search"
          id="endereco-pessoa"
          name="q"
          placeholder="Ex.: Rua da República, Cidade Baixa"
          autocomplete="street-address"
          minlength="3"
          maxlength="300"
          required
        />
        <button type="submit" class="botao botao--pequeno" aria-label="Buscar endereço">Buscar</button>
      </div>
    </form>
    <div class="painel-localizacao__opcoes"></div>
  </section>
</main>
<script type="application/json" id="dados-mapa"><%- fmt.jsonSeguro(dadosMapa) %></script>
<%- include('partials/foot') %>
