<%- include('../partials/head') %>
<main id="conteudo" class="conteudo texto">
  <div class="alerta alerta--sucesso" role="status">
    <p><strong>Recebemos sua mensagem. Agradecemos por compartilhar.</strong></p>
  </div>

  <% if (tipo === 'SUGESTAO_LOCAL') { %>
  <h1>Sua sugestão chegou à ONG</h1>
  <p class="lead">
    A equipe da Somos vai conferir as informações. Se o local for validado, ele passa a aparecer no
    mapa.
  </p>
  <% } else if (tipo === 'DISCRIMINACAO') { %>
  <h1>Seu relato chegou à ONG</h1>
  <p class="lead">
    Sentimos muito pelo que você passou. A ONG Somos vai usar seu relato para cobrar providências.
    Você também pode registrar uma denúncia oficial:
  </p>
  <%- include('../partials/canais-denuncia') %>
  <% } else { %>
  <h1>Seu relato chegou à ONG</h1>
  <p class="lead">
    Relatos como o seu ajudam a ONG Somos a acompanhar os serviços e cobrar melhorias.
  </p>
  <% } %>

  <p class="acoes">
    <a class="botao" href="/">Voltar para o mapa</a>
    <a class="botao botao--fantasma" href="/enviar">Enviar outro</a>
  </p>
</main>
<%- include('../partials/foot') %>
