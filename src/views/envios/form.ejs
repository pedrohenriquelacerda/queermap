<%- include('../partials/head') %>
<%
  const campo = (dados) => include('../partials/campo', { erros, ...dados });
  const opcoesLocal = [
    { valor: '', texto: 'Escolha o local' },
    ...locais.map((l) => ({ valor: l.id, texto: l.bairro ? `${l.nome} (${l.bairro})` : l.nome })),
    { valor: outroLugar, texto: 'Outro lugar (não está no mapa)' },
  ];
  const opcoesCategoria = [
    { valor: '', texto: 'Escolha o tipo de serviço' },
    ...categorias.map((c) => ({ valor: c.id, texto: c.nome })),
  ];
%>
<main id="conteudo" class="conteudo texto">
  <h1>Enviar sugestão ou relato</h1>
  <p class="lead">
    Sua mensagem vai só para a equipe da ONG Somos. Nada é publicado no site.
  </p>

  <% if (erroGeral) { %>
  <div class="alerta alerta--erro" role="alert"><p><%= erroGeral %></p></div>
  <% } else if (Object.keys(erros).length > 0) { %>
  <div class="alerta alerta--erro" role="alert"><p><strong>Revise os campos marcados.</strong></p></div>
  <% } %>

  <form class="cartao form-envio" method="post" action="/enviar" id="form-envio" novalidate>
    <fieldset class="escolha-tipo<%= erros.tipo ? ' campo--invalido' : '' %>" <% if (erros.tipo) { %>aria-describedby="tipo-erro"<% } %>>
      <legend class="campo__rotulo">O que você quer enviar?</legend>
      <div class="escolha-tipo__opcoes">
        <% for (const [valor, t] of Object.entries(tipos)) { %>
        <label class="escolha-tipo__opcao">
          <input type="radio" name="tipo" value="<%= valor %>" <%= valores.tipo === valor ? 'checked' : '' %> required />
          <span>
            <strong><%= t.rotulo %></strong>
            <span class="campo__ajuda"><%= t.ajuda %></span>
          </span>
        </label>
        <% } %>
      </div>
      <% if (erros.tipo) { %><span class="campo__erro" id="tipo-erro"><%= erros.tipo %></span><% } %>
    </fieldset>

    <noscript>
      <p class="campo__ajuda">
        Se você for enviar um relato de discriminação, consulte os
        <a href="/canais-de-denuncia" target="_blank" rel="noopener">canais oficiais de denúncia</a>
        (abre em outra aba, sem perder o que você escreveu).
      </p>
    </noscript>

    <div class="alerta alerta--aviso" data-se-tipo="DISCRIMINACAO" hidden>
      <p>
        Se você está em perigo imediato, ligue <a href="tel:190">190</a> ou <a href="tel:192">192</a>.
        <%# Botão, e não link: sair da página faria perder o relato já escrito. %>
        <button type="button" class="botao-link" data-abrir-canais>Ver os canais oficiais de denúncia</button>.
      </p>
    </div>

    <div data-se-tipo="SUGESTAO_LOCAL">
      <%- campo({ nome: 'nomeLocalSugerido', rotulo: 'Nome do local sugerido', valor: valores.nomeLocalSugerido, attrs: { required: true, maxlength: 150 } }) %>
      <%- campo({ nome: 'categoriaSugeridaId', rotulo: 'Tipo de serviço', tipo: 'select', valor: valores.categoriaSugeridaId, opcoes: opcoesCategoria, attrs: { required: true } }) %>
      <%- campo({ nome: 'enderecoLocalSugerido', rotulo: 'Endereço do local', valor: valores.enderecoLocalSugerido, ajuda: 'Rua e número. Se não souber, o bairro e a cidade.', attrs: { required: true, maxlength: 300 } }) %>
      <%- campo({ nome: 'contatoLocalSugerido', rotulo: 'Contato do local', valor: valores.contatoLocalSugerido, ajuda: 'Telefone, site, e-mail ou rede social do local.', attrs: { required: true, maxlength: 200 } }) %>
    </div>

    <div data-se-tipo="ELOGIO RECLAMACAO DISCRIMINACAO">
      <%- campo({ nome: 'localId', rotulo: 'Sobre qual local?', tipo: 'select', valor: valores.localId, opcoes: opcoesLocal, attrs: { required: true } }) %>
      <div data-se-outro-lugar>
        <%- campo({ nome: 'nomeLocalRelato', rotulo: 'Nome do lugar', valor: valores.nomeLocalRelato, ajuda: 'Só se escolheu "Outro lugar". Ex.: UBS Santa Cecília, Hospital X.', attrs: { maxlength: 150 } }) %>
      </div>
    </div>

    <%- campo({ nome: 'mensagem', rotulo: 'Sua mensagem', tipo: 'textarea', valor: valores.mensagem, ajuda: 'Conte o que aconteceu ou por que o local deveria estar no mapa. Até 2.000 caracteres.', attrs: { required: true, minlength: 10, maxlength: 2000, rows: 6 } }) %>

    <%- campo({ nome: 'email', rotulo: 'Seu e-mail', tipo: 'email', valor: '', ajuda: 'Para enviar um código de confirmação. O e-mail não fica guardado.', attrs: { required: true, autocomplete: 'email' } }) %>

    <div class="campo">
      <label class="opcao">
        <input type="checkbox" name="desejaContato" <%= valores.desejaContato === 'on' || valores.desejaContato === true ? 'checked' : '' %> />
        <span>
          Quero que a ONG entre em contato comigo
          <span class="campo__ajuda">Só nesse caso o e-mail é salvo, e apenas a equipe da ONG tem acesso.</span>
        </span>
      </label>
    </div>

    <div class="campo">
      <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-language="pt-br"></div>
      <noscript>
        <p class="campo__erro">A verificação anti-robô precisa de JavaScript ativado.</p>
      </noscript>
    </div>

    <button type="submit" class="botao">Continuar</button>
    <p class="campo__ajuda form-envio__privacidade">
      Veja como tratamos seus dados na página de <a href="/privacidade">Privacidade</a>.
    </p>
  </form>

  <dialog class="modal-canais" id="modal-canais" aria-labelledby="modal-canais-titulo">
    <div class="modal-canais__cabecalho">
      <h2 id="modal-canais-titulo">Veja os canais oficiais para o seu caso</h2>
      <button class="botao botao--fantasma botao--pequeno" type="button" data-fechar-canais>Fechar</button>
    </div>
    <p class="alerta alerta--erro" role="note">
      <strong>Em situação de perigo imediato</strong>, ligue para a Polícia Militar (190) ou para o
      SAMU (192).
    </p>
    <%- include('../partials/canais-denuncia-lista', { comTitulo: false }) %>
    <p class="alerta alerta--aviso">
      O envio do relato ao Mapa SerQueer não substitui uma denúncia formal nos canais oficiais.
    </p>
    <button class="botao" type="button" data-fechar-canais>Fechar e continuar o envio</button>
  </dialog>
</main>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<%- include('../partials/foot') %>
