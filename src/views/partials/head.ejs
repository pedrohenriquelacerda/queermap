<%
  const tituloCompleto = locals.title ? `${title} · ${siteName}` : siteName;
  const descricao = locals.descricao || descricaoPadrao;
  const url = siteUrl + caminho;
  // usaMapa = página do mapa em tela cheia; usaLeaflet = só carrega o Leaflet.
  const leaflet = locals.usaMapa || locals.usaLeaflet;
%><!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= tituloCompleto %></title>
    <meta name="description" content="<%= descricao %>" />
    <meta name="theme-color" content="#6b3fa0" />
    <link rel="canonical" href="<%= url %>" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="<%= siteName %>" />
    <meta property="og:title" content="<%= tituloCompleto %>" />
    <meta property="og:description" content="<%= descricao %>" />
    <meta property="og:url" content="<%= url %>" />

    <link
      rel="preload"
      href="/vendor/fontes/atkinson-hyperlegible-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <% if (leaflet) { %>
    <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
    <% } %>
    <link rel="stylesheet" href="/css/base.css" />
    <% if (leaflet) { %>
    <link rel="stylesheet" href="/css/mapa.css" />
    <% } %>
  </head>
  <body>
    <div class="pagina<%= locals.usaMapa ? ' pagina--mapa' : '' %>">
      <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
      <%- include('topo') %>
