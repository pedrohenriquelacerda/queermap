<%# comTitulo: false quando quem inclui já tem o próprio título (ex.: pop-up do formulário). %>
<% if (locals.comTitulo !== false) { %><h2>Canais oficiais de denúncia</h2><% } %>
<% if (canais.length > 0) { %>
<ul class="contatos">
  <% for (const canal of canais) { const telefone = fmt.linkTelefone(canal.telefone); const link = fmt.urlSegura(canal.link); %>
  <li class="cartao">
    <h3><%= canal.nome %></h3>
    <p><%= canal.descricao %></p>
    <div class="contatos__acoes">
      <% if (telefone) { %><a class="botao botao--pequeno" href="<%= telefone %>" aria-label="Ligar <%= canal.telefone %> (<%= canal.nome %>)">Ligar <%= canal.telefone %></a><% } %>
      <% if (link) { %>
      <a class="botao botao--pequeno botao--secundario" href="<%= link %>" target="_blank" rel="noopener noreferrer" aria-label="Acessar canal oficial: <%= canal.nome %> (abre em nova aba)">Acessar canal oficial</a>
      <% } %>
    </div>
  </li>
  <% } %>
</ul>
<% } else { %>
<p>
  Os canais oficiais não estão disponíveis agora. Se precisar de ajuda para denunciar, procure a
  equipe da ONG Somos.
</p>
<% } %>
